--- /dev/null
+++ b/Tools/autotest/default_params/motorblimp.parm
@@ -0,0 +1,117 @@
+# ArduMotorBlimp SITL defaults for a reversible four-motor ring.
+# PWM 1500 is stopped, 1000 is full reverse, and 2000 is full forward.
+
+SERVO1_FUNCTION 33
+SERVO2_FUNCTION 34
+SERVO3_FUNCTION 35
+SERVO4_FUNCTION 36
+
+SERVO1_MIN 1000
+SERVO1_TRIM 1500
+SERVO1_MAX 2000
+SERVO2_MIN 1000
+SERVO2_TRIM 1500
+SERVO2_MAX 2000
+SERVO3_MIN 1000
+SERVO3_TRIM 1500
+SERVO3_MAX 2000
+SERVO4_MIN 1000
+SERVO4_TRIM 1500
+SERVO4_MAX 2000
+
+RC1_MIN 1000
+RC1_TRIM 1500
+RC1_MAX 2000
+RC2_MIN 1000
+RC2_TRIM 1500
+RC2_MAX 2000
+RC3_MIN 1000
+RC3_TRIM 1500
+RC3_MAX 2000
+RC4_MIN 1000
+RC4_TRIM 1500
+RC4_MAX 2000
+
+# Mark the single simulated accelerometer as calibrated so normal (non-force)
+# arming exercises the same pre-arm path as hardware.
+SIM_IMU_COUNT 1
+INS_ACCOFFS_X 0.001
+INS_ACCOFFS_Y 0.001
+INS_ACCOFFS_Z 0.001
+INS_ACCSCAL_X 1.001
+INS_ACCSCAL_Y 1.001
+INS_ACCSCAL_Z 1.001
+
+# Matrix columns are forward, roll, pitch, yaw. Motor order is
+# M1 top, M2 right, M3 bottom, M4 left when looking along body X.
+MIX_M1_FWD 1
+MIX_M1_RLL 1
+MIX_M1_PIT -1
+MIX_M1_YAW 0
+MIX_M2_FWD 1
+MIX_M2_RLL -1
+MIX_M2_PIT 0
+MIX_M2_YAW -1
+MIX_M3_FWD 1
+MIX_M3_RLL 1
+MIX_M3_PIT 1
+MIX_M3_YAW 0
+MIX_M4_FWD 1
+MIX_M4_RLL -1
+MIX_M4_PIT 0
+MIX_M4_YAW 1
+
+# Controller defaults are explicit here so --wipe starts from the same gains
+# in every ArduPilot checkout and CI runner.
+ATC_ANG_RLL_P 2.5
+ATC_ANG_PIT_P 2.5
+ATC_ANG_YAW_P 2
+ATC_RAT_RLL_MAX 60
+ATC_RAT_PIT_MAX 60
+ATC_RAT_YAW_MAX 45
+MAN_RLL_MAX 30
+MAN_PIT_MAX 60
+MAN_YAW_RATE 45
+MAN_FWD_MAX 1
+PSC_POS_P 0.4
+PSC_VEL_P 1
+PSC_VEL_I 0.1
+PSC_VEL_IMAX 0.2
+NAV_VEL_MAX 0.5
+NAV_ACC_MAX 0.3
+NAV_FWD_MAX 0.7
+NAV_PIT_MAX 60
+NAV_ACC_MIN 0.02
+NAV_REV_HYST 0.15
+NAV_THR_ANGLE 30
+WP_RADIUS 0.4
+WP_SPEED 0.15
+UWB_ERR_MAX 1.0
+
+# Useful streams for manual inspection; the smoke test also requests its
+# messages explicitly with MAV_CMD_SET_MESSAGE_INTERVAL.
+MAV1_RC_CHAN 10
+MAV1_EXTRA1 10
+
+# Automatic navigation in SITL: the one vehicle UWB tag supplies direct XYZ
+# position through AP_Beacon, while yaw comes only from the internal compass.
+# Keep the default simulated vehicle location at the beacon origin as well.
+# This makes both sim_vehicle.py and direct binary launches valid even when
+# the caller does not provide an explicit --home/-l override.
+SIM_OPOS_LAT 55.751244
+SIM_OPOS_LNG 37.618423
+SIM_OPOS_ALT 200
+SIM_OPOS_HDG 0
+BCN_TYPE 10
+BCN_LATITUDE 55.751244
+BCN_LONGITUDE 37.618423
+BCN_ALT 200
+GPS1_TYPE 0
+AHRS_EKF_TYPE 3
+EK2_ENABLE 0
+EK3_ENABLE 1
+EK3_SRC1_POSXY 4
+EK3_SRC1_POSZ 4
+EK3_SRC1_VELXY 0
+EK3_SRC1_VELZ 0
+EK3_SRC1_YAW 1
